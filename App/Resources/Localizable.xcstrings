          "stringUnit": {
            "state": "translated",
            "value": "Torrent (aria2)"
          }
        }
      }
    },
    "Torrent downloads run on aria2c, which ships inside the app. If it's missing, install it with “brew install aria2” (then relaunch) or point to a custom binary below.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent indirmeleri uygulamanın içindeki aria2c ile yapılır. Eksikse “brew install aria2” ile kurun (sonra yeniden başlatın) veya aşağıdan özel binary gösterin."
          }
        }
      }
    },
    "Torrent finished but produced no files.": {
