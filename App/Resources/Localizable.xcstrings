{
  "sourceLanguage": "en",
  "strings": {
    "…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "…"
          }
        }
      }
    },
    "%@ · %lld/%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld/%3$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld/%3$lld"
          }
        }
      }
    },
    "%@ does not allow apps to install extensions automatically, so the extension is loaded from a folder. The files are placed in:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, uygulamaların eklentileri otomatik kurmasına izin vermez; bu yüzden eklenti bir klasörden yüklenir. Dosyalar şuraya yerleştirilir:"
          }
        }
      }
    },
    "%@ installed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuruldu."
          }
        }
      }
    },
    "%@ is ready": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hazır"
          }
        }
      }
    },
    "%@ must be %lld hex characters (got %lld).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ must be %2$lld hex characters (got %3$lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld onaltılık karakter olmalı (gelen %3$lld)."
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%@/s": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/sn"
          }
        }
      }
    },
    "%1$@ does not allow apps to install extensions automatically. On the extensions page that just opened:\n\n1. Turn on “Developer mode” (top right).\n2. Click “Load unpacked”.\n3. Select this folder (press ⇧⌘G in the file dialog and paste the path):\n\n%2$@": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, uygulamaların eklentileri otomatik kurmasına izin vermez. Az önce açılan eklentiler sayfasında:\n\n1. “Geliştirici modu”nu açın (sağ üst).\n2. “Paketlenmemiş öğe yükle”ye tıklayın.\n3. Şu klasörü seçin (dosya penceresinde ⇧⌘G basıp yolu yapıştırın):\n\n%2$@"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
