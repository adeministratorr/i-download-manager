    "Skip This Version": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Sürümü Atla"
          }
        }
      }
    },
    "Some videos require a signed-in account. Sign in once in the built-in browser window; the saved cookies are passed to yt-dlp for video downloads. Downloads started from the browser extension already carry the browser's cookies.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı videolar oturum açmış bir hesap gerektirir. Uygulama içi tarayıcı penceresinde bir kez giriş yapın; kaydedilen çerezler video indirmelerinde yt-dlp'ye aktarılır. Tarayıcı eklentisinden başlatılan indirmeler zaten tarayıcının çerezlerini taşır."
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "tr": {
